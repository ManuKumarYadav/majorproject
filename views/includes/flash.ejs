<div class="toast-container-custom">
    <% if(success && success.length) { %>
        <div class="luxury-toast luxury-toast-success alert alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check toast-icon"></i>
            <div class="toast-message-text"><%= success %></div>
            <button type="button" class="toast-close-btn" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    <% } %>

    <% if(error && error.length) { %>
        <div class="luxury-toast luxury-toast-error alert alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation toast-icon"></i>
            <div class="toast-message-text"><%= error %></div>
            <button type="button" class="toast-close-btn" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    <% } %>
</div>