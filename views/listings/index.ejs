<% layout("/layouts/boilerplate") %>

<!-- Category Filters Bar & Tax Toggle -->
<section class="filters-wrapper">
    <div class="filters-container">
        <div class="filters-scroll" id="filterPillsContainer">
            <div class="filter-pill active" data-category="all">
                <i class="fa-solid fa-fire"></i>
                <span>Trending</span>
            </div>
            <div class="filter-pill" data-category="rooms">
                <i class="fa-solid fa-bed"></i>
                <span>Rooms</span>
            </div>
            <div class="filter-pill" data-category="mountains">
                <i class="fa-solid fa-mountain"></i>
                <span>Mountains</span>
            </div>
            <div class="filter-pill" data-category="castles">
                <i class="fa-brands fa-fort-awesome"></i>
                <span>Castles</span>
            </div>
            <div class="filter-pill" data-category="camping">
                <i class="fa-solid fa-campground"></i>
                <span>Camping</span>
            </div>
            <div class="filter-pill" data-category="farms">
                <i class="fa-solid fa-wheat-awn"></i>
                <span>Farms</span>
            </div>
            <div class="filter-pill" data-category="iconic-cities">
                <i class="fa-solid fa-mountain-city"></i>
                <span>Iconic Cities</span>
            </div>
            <div class="filter-pill" data-category="arctic">
                <i class="fa-solid fa-snowflake"></i>
                <span>Arctic</span>
            </div>
            <div class="filter-pill" data-category="domes">
                <i class="fa-solid fa-igloo"></i>
                <span>Domes</span>
            </div>
            <div class="filter-pill" data-category="boats">
                <i class="fa-solid fa-sailboat"></i>
                <span>Boats</span>
            </div>
            <div class="filter-pill" data-category="beach">
                <i class="fa-solid fa-umbrella-beach"></i>
                <span>Beachfront</span>
            </div>
            <div class="filter-pill" data-category="pools">
                <i class="fa-solid fa-water-ladder"></i>
                <span>Amazing Pools</span>
            </div>
        </div>

        <!-- Display Total After Taxes Toggle -->
        <div class="tax-toggle-box ms-2">
            <div class="form-check form-switch mb-0 d-flex align-items-center">
                <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
                <label class="form-check-label ms-2" for="taxSwitch">Display total after taxes</label>
            </div>
        </div>
    </div>
</section>

<!-- Listings Grid -->
<div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mt-1" id="listingsGrid">
    <% for(let listing of allListings) { %>
        <div class="col listing-item" 
             data-title="<%= listing.title ? listing.title.toLowerCase() : '' %>"
             data-location="<%= listing.location ? listing.location.toLowerCase() : '' %>"
             data-country="<%= listing.country ? listing.country.toLowerCase() : '' %>">
            
            <div class="luxury-card h-100">
                <div class="card-media-box">
                    <a href="/listings/<%= listing._id %>" class="d-block w-100 h-100">
                        <img 
                            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80' %>" 
                            class="card-media-img" 
                            alt="<%= listing.title %>"
                            loading="lazy"
                        />
                    </a>
                    
                    <!-- Guest Favorite / Verified Badge -->
                    <span class="card-badge-top-left">
                        <i class="fa-solid fa-award text-warning"></i> Guest Favorite
                    </span>

                    <!-- Heart Favorite Button -->
                    <button class="card-favorite-btn" type="button" aria-label="Add to favorites" onclick="toggleFavorite(this, event)">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                </div>

                <a href="/listings/<%= listing._id %>" class="listing-card-wrapper mb-0">
                    <div class="card-details-box">
                        <div class="card-header-row">
                            <h6 class="card-title-text" title="<%= listing.title %>"><%= listing.title %></h6>
                            <div class="card-rating-badge">
                                <i class="fa-solid fa-star"></i>
                                <span><%= (4.8 + ((listing.title.length % 3) * 0.1)).toFixed(1) %></span>
                            </div>
                        </div>

                        <div class="card-location-text">
                            <i class="fa-solid fa-location-dot me-1 small text-muted"></i><%= listing.location %>, <%= listing.country %>
                        </div>

                        <div class="card-pricing-row">
                            <span class="card-price-val" data-base-price="<%= listing.price || 0 %>">
                                &#8377; <%= listing.price ? Number(listing.price).toLocaleString("en-IN") : '0' %>
                            </span>
                            <span class="card-price-unit">/ night</span>
                            <span class="gst-badge">+18% GST</span>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    <% } %>
</div>

<!-- Empty State Search Message -->
<div id="noResultsState" class="text-center py-5 d-none">
    <div class="mb-3">
        <i class="fa-solid fa-magnifying-glass-location text-muted" style="font-size: 3.5rem;"></i>
    </div>
    <h4 class="fw-bold text-dark">No stays found matching your search</h4>
    <p class="text-muted">Try changing your keywords, adjusting filters, or explore all available stays.</p>
    <button class="btn btn-dark rounded-pill px-4 mt-2" onclick="resetFilters()">Reset All Filters</button>
</div>