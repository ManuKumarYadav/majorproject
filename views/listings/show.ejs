<% layout("/layouts/boilerplate") %>

<div class="show-header-section mt-2">
    <h1 class="show-title-heading"><%= listing.title %></h1>
    
    <div class="show-meta-subbar">
        <div class="show-meta-left">
            <div class="show-meta-item">
                <i class="fa-solid fa-star text-warning"></i>
                <span class="fw-bold text-dark">4.92</span>
                <span class="text-muted">(<%= listing.reviews ? listing.reviews.length : 0 %> reviews)</span>
            </div>
            <div class="show-meta-item">
                <i class="fa-solid fa-award text-danger"></i>
                <span class="fw-bold">Superhost</span>
            </div>
            <div class="show-meta-item">
                <i class="fa-solid fa-location-dot text-muted"></i>
                <span><%= listing.location %>, <%= listing.country %></span>
            </div>
        </div>

        <div class="show-meta-actions">
            <button class="meta-action-btn" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
                <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
            </button>
            <button class="meta-action-btn" onclick="toggleFavorite(this, event)">
                <i class="fa-regular fa-heart"></i> Save
            </button>
        </div>
    </div>
</div>

<!-- Hero Showcase Gallery -->
<div class="showcase-gallery-hero">
    <img 
        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1200&q=80' %>" 
        alt="<%= listing.title %>"
    />
</div>

<div class="row g-5">
    <!-- Main Details Column (Left) -->
    <div class="col-lg-7">
        
        <!-- Host Profile Card -->
        <div class="host-profile-card">
            <div class="d-flex align-items-center gap-3">
                <div class="host-avatar-box">
                    <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Hosted by <%= listing.owner ? listing.owner.username : 'Rentrova Host' %></h5>
                    <p class="text-muted mb-0 small">Superhost • 2 years hosting • Responds within an hour</p>
                </div>
            </div>
            <div class="badge bg-light text-dark border p-2 px-3 rounded-pill fw-semibold">
                <i class="fa-solid fa-shield-halved text-success me-1"></i> Verified
            </div>
        </div>

        <!-- Highlights & Perks -->
        <div class="highlights-list">
            <div class="highlight-item">
                <div class="highlight-icon-box">
                    <i class="fa-solid fa-door-open"></i>
                </div>
                <div class="highlight-content">
                    <h5>Self check-in</h5>
                    <p>Check yourself in easily with the smart keypad upon arrival.</p>
                </div>
            </div>
            <div class="highlight-item">
                <div class="highlight-icon-box">
                    <i class="fa-solid fa-location-crosshairs"></i>
                </div>
                <div class="highlight-content">
                    <h5>Great location</h5>
                    <p>95% of recent guests gave the location a 5-star rating.</p>
                </div>
            </div>
            <div class="highlight-item">
                <div class="highlight-icon-box">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="highlight-content">
                    <h5>Free cancellation for 48 hours</h5>
                    <p>Get a full refund if your travel plans change unexpectedly.</p>
                </div>
            </div>
        </div>

        <!-- About this space -->
        <div class="mb-4 pb-4 border-bottom">
            <h4 class="fw-bold mb-3">About this space</h4>
            <p class="text-secondary leading-relaxed" style="white-space: pre-line; line-height: 1.7; font-size: 1.02rem;">
                <%= listing.description %>
            </p>
        </div>

        <!-- Amenities Grid -->
        <div class="mb-4 pb-4 border-bottom">
            <h4 class="fw-bold mb-3">What this place offers</h4>
            <div class="row row-cols-2 g-3">
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-wifi text-muted fs-5"></i>
                    <span class="text-dark">High-speed Fast Wifi</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-square-parking text-muted fs-5"></i>
                    <span class="text-dark">Free parking on premises</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-water-ladder text-muted fs-5"></i>
                    <span class="text-dark">Private outdoor pool</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-snowflake text-muted fs-5"></i>
                    <span class="text-dark">Air conditioning & Heating</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-kitchen-set text-muted fs-5"></i>
                    <span class="text-dark">Fully equipped Chef kitchen</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-tv text-muted fs-5"></i>
                    <span class="text-dark">65" 4K Smart TV with Netflix</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-mountain-sun text-muted fs-5"></i>
                    <span class="text-dark">Scenic mountain & skyline view</span>
                </div>
                <div class="col d-flex align-items-center gap-3">
                    <i class="fa-solid fa-shield-heart text-muted fs-5"></i>
                    <span class="text-dark">Carbon monoxide & smoke alarm</span>
                </div>
            </div>
        </div>

        <!-- Owner Actions (Edit / Delete) -->
        <% if(currentUser && listing.owner && listing.owner._id.equals(currentUser._id)){ %>
            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-4 border mb-4">
                <span class="fw-bold text-dark"><i class="fa-solid fa-gear me-1"></i> Host Controls:</span>
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                </a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                    <button class="btn btn-outline-danger rounded-pill px-4">
                        <i class="fa-solid fa-trash-can me-1"></i> Delete
                    </button>
                </form>
            </div>
        <% } %>

        <!-- Reviews Section -->
        <div class="mb-4 pb-4 border-bottom">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="fa-solid fa-star text-warning fs-4"></i>
                <h4 class="fw-bold mb-0">4.92 • <%= listing.reviews ? listing.reviews.length : 0 %> Reviews</h4>
            </div>

            <!-- Review Submission Form -->
            <% if(currentUser) { %>
                <div class="luxury-form-card mb-4 p-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-pen-nib text-danger me-2"></i>Leave a Review</h5>
                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                        
                        <div class="mb-3">
                            <label class="form-label-modern">Your Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label-modern">Comments</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control form-control-modern" placeholder="Share details of your experience at this place..." required></textarea>
                            <div class="invalid-feedback">Please write a comment for your review.</div>
                        </div>

                        <button type="submit" class="btn btn-dark rounded-pill px-4">
                            <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
                        </button>
                    </form>
                </div>
            <% } else { %>
                <div class="alert alert-light border rounded-4 d-flex align-items-center justify-content-between p-3 mb-4">
                    <span class="text-muted"><i class="fa-solid fa-lock me-2 text-warning"></i>Want to leave a review? Please log in first.</span>
                    <a href="/login" class="btn btn-sm btn-dark rounded-pill px-3">Log In</a>
                </div>
            <% } %>

            <!-- All Reviews List -->
            <% if(listing.reviews && listing.reviews.length > 0) { %>
                <div class="row g-3">
                    <% for(let review of listing.reviews) { %>
                        <div class="col-md-6">
                            <div class="review-card-modern">
                                <div>
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="review-author-avatar">
                                            <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">@<%= review.author ? review.author.username : 'Guest' %></h6>
                                            <span class="text-muted small">Verified Guest</span>
                                        </div>
                                    </div>
                                    <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                                    <p class="text-secondary small mb-3" style="line-height: 1.5;"><%= review.comment %></p>
                                </div>

                                <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Delete your review?');">
                                        <button class="btn btn-sm text-danger p-0 fw-semibold">
                                            <i class="fa-solid fa-trash-can me-1"></i> Delete Review
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-muted fst-italic">No reviews yet for this listing. Be the first to share your experience!</p>
            <% } %>
        </div>

        <!-- Location & Map -->
        <div class="mb-4">
            <h4 class="fw-bold mb-2">Where you'll be</h4>
            <p class="text-muted"><i class="fa-solid fa-map-pin text-danger me-1"></i> <%= listing.location %>, <%= listing.country %></p>
            
            <div class="luxury-map-wrapper">
                <div id="listingMap" class="luxury-map-box"></div>
            </div>
        </div>

    </div>

    <!-- Sticky Booking Widget Column (Right) -->
    <div class="col-lg-5">
        <div class="sticky-reservation-card">
            
            <div class="reservation-price-header">
                <div>
                    <span class="res-price-amount">&#8377; <%= listing.price ? Number(listing.price).toLocaleString("en-IN") : '0' %></span>
                    <span class="text-muted"> / night</span>
                </div>
                <div class="card-rating-badge">
                    <i class="fa-solid fa-star"></i>
                    <span>4.92 • <%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
                </div>
            </div>

            <!-- Booking Date & Guest Box -->
            <div class="res-booking-table">
                <div class="res-date-row">
                    <div class="res-date-cell">
                        <label class="res-cell-label">Check-in</label>
                        <input type="date" id="checkInDate" class="res-cell-input">
                    </div>
                    <div class="res-date-cell">
                        <label class="res-cell-label">Checkout</label>
                        <input type="date" id="checkOutDate" class="res-cell-input">
                    </div>
                </div>
                <div class="res-guest-cell">
                    <label class="res-cell-label">Guests</label>
                    <select id="guestCount" class="res-cell-input" style="cursor: pointer;">
                        <option value="1">1 Guest</option>
                        <option value="2" selected>2 Guests</option>
                        <option value="3">3 Guests</option>
                        <option value="4">4 Guests</option>
                        <option value="5">5+ Guests</option>
                    </select>
                </div>
            </div>

            <!-- Reserve Button -->
            <button class="btn-luxury-primary mb-3" type="button" onclick="handleReserve()">
                <i class="fa-solid fa-bolt"></i> Reserve Now
            </button>

            <p class="text-center text-muted small mb-3">You won't be charged yet</p>

            <!-- Price Breakdown Calculation -->
            <div class="res-breakdown">
                <div class="res-breakdown-row">
                    <span id="nightRateLabel">&#8377; <%= listing.price ? Number(listing.price).toLocaleString("en-IN") : '0' %> x <span id="nightsCount">5</span> nights</span>
                    <span id="baseCost">&#8377; <%= ((listing.price || 0) * 5).toLocaleString("en-IN") %></span>
                </div>
                <div class="res-breakdown-row">
                    <span>Cleaning & Sanitization fee</span>
                    <span id="cleaningCost">&#8377; 50</span>
                </div>
                <div class="res-breakdown-row">
                    <span>Rentrova service fee</span>
                    <span id="serviceCost">&#8377; 30</span>
                </div>
                <div class="res-breakdown-row">
                    <span>GST (18%)</span>
                    <span id="gstCost">&#8377; 0</span>
                </div>
                <div class="res-breakdown-row res-total-row">
                    <span>Total with taxes & fees</span>
                    <span id="grandTotal">&#8377; 0</span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex align-items-center gap-3 text-muted small">
                <i class="fa-solid fa-shield-heart text-danger fs-4"></i>
                <span><strong>Rentrova AirCover</strong> protects every booking with comprehensive cancellation and safety guarantees.</span>
            </div>

        </div>
    </div>
</div>

<!-- Razorpay Checkout SDK -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<!-- Live Dynamic Leaflet Map & Razorpay Booking Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const mapContainer = document.getElementById("listingMap");
        if (mapContainer && typeof L !== "undefined") {
            // Default initial coordinates (New Delhi as fallback)
            let defaultLat = 28.6139;
            let defaultLon = 77.2090;

            // Initialize Map
            const map = L.map("listingMap", {
                zoomControl: true,
                scrollWheelZoom: false, // Prevents accidental scrolling while viewing page
            }).setView([defaultLat, defaultLon], 13);

            // Modern CartoDB Voyager Tile Layer (Airbnb-like soft aesthetic)
            L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
                maxZoom: 19,
                subdomains: "abcd",
                attribution: "© OpenStreetMap contributors © CARTO"
            }).addTo(map);

            // Luxury Custom Rentrova Marker Icon
            const customIcon = L.divIcon({
                className: "custom-rentrova-pin",
                html: `
                    <div style="
                        background: linear-gradient(135deg, #FF385C, #D70466);
                        width: 46px;
                        height: 46px;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: white;
                        box-shadow: 0 6px 18px rgba(255, 56, 92, 0.45);
                        border: 3px solid #FFFFFF;
                        font-size: 1.15rem;
                        cursor: pointer;
                        transition: transform 0.2s ease;
                    ">
                        <i class="fa-solid fa-house-chimney"></i>
                    </div>
                `,
                iconSize: [46, 46],
                iconAnchor: [23, 23],
                popupAnchor: [0, -26]
            });

            const marker = L.marker([defaultLat, defaultLon], { icon: customIcon }).addTo(map);
            
            const popupContent = `
                <div style="padding: 4px; font-family: 'Plus Jakarta Sans', sans-serif;">
                    <h6 style="margin: 0 0 4px 0; font-weight: 700; color: #0F172A;"><%= listing.title %></h6>
                    <p style="margin: 0 0 6px 0; font-size: 0.85rem; color: #64748B;"><i class="fa-solid fa-location-dot" style="color: #FF385C; margin-right: 4px;"></i><%= listing.location %>, <%= listing.country %></p>
                    <span style="display: inline-block; font-size: 0.75rem; font-weight: 600; color: #10B981; background: #ECFDF5; padding: 2px 8px; border-radius: 999px;">Exact location provided after booking</span>
                </div>
            `;
            marker.bindPopup(popupContent).openPopup();

            // 🌍 Live Dynamic Geocoding using OpenStreetMap Nominatim
            const locationQuery = "<%= listing.location %>, <%= listing.country %>";
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationQuery)}&limit=1`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const liveLat = parseFloat(data[0].lat);
                        const liveLon = parseFloat(data[0].lon);

                        map.flyTo([liveLat, liveLon], 13, { duration: 1.5 });
                        marker.setLatLng([liveLat, liveLon]);

                        // Add Airbnb-style area privacy radius circle
                        L.circle([liveLat, liveLon], {
                            color: "#FF385C",
                            weight: 1.5,
                            fillColor: "#FF385C",
                            fillOpacity: 0.08,
                            radius: 800
                        }).addTo(map);
                    }
                })
                .catch(err => {
                    console.log("Live geocoding fallback used:", err);
                });
        }

        // Set default dates for booking widget
        const today = new Date();
        const checkIn = new Date(today);
        checkIn.setDate(today.getDate() + 2);
        const checkOut = new Date(today);
        checkOut.setDate(today.getDate() + 7);

        const checkInInput = document.getElementById("checkInDate");
        const checkOutInput = document.getElementById("checkOutDate");
        
        function updatePricing() {
            const start = new Date(checkInInput.value);
            const end = new Date(checkOutInput.value);
            const diffTime = Math.abs(end - start);
            let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            if (isNaN(diffDays) || diffDays < 1) diffDays = 1;

            const basePrice = <%= listing.price || 0 %>;
            const baseTotal = basePrice * diffDays;
            const cleaning = Math.max(50, Math.round(baseTotal * 0.03));
            const service = Math.max(30, Math.round(baseTotal * 0.02));
            const gst = Math.round((baseTotal + cleaning + service) * 0.18);
            const grand = baseTotal + cleaning + service + gst;

            document.getElementById("nightsCount").innerText = diffDays;
            document.getElementById("baseCost").innerText = "₹ " + baseTotal.toLocaleString("en-IN");
            document.getElementById("cleaningCost").innerText = "₹ " + cleaning.toLocaleString("en-IN");
            document.getElementById("serviceCost").innerText = "₹ " + service.toLocaleString("en-IN");
            document.getElementById("gstCost").innerText = "₹ " + gst.toLocaleString("en-IN");
            document.getElementById("grandTotal").innerText = "₹ " + grand.toLocaleString("en-IN");
        }

        if (checkInInput && checkOutInput) {
            checkInInput.value = checkIn.toISOString().split("T")[0];
            checkOutInput.value = checkOut.toISOString().split("T")[0];

            updatePricing();

            checkInInput.addEventListener("change", updatePricing);
            checkOutInput.addEventListener("change", updatePricing);
        }
    });

    async function handleReserve() {
        const isUserLoggedIn = <%= currentUser ? 'true' : 'false' %>;
        if (!isUserLoggedIn) {
            alert("Please log in to reserve this place.");
            window.location.href = "/login";
            return;
        }

        const checkIn = document.getElementById("checkInDate")?.value || new Date().toISOString().split("T")[0];
        const checkOut = document.getElementById("checkOutDate")?.value || new Date(Date.now() + 86400000 * 2).toISOString().split("T")[0];
        const guests = document.getElementById("guestCount")?.value || 1;

        const reserveBtn = document.querySelector(".btn-luxury-primary");
        const originalText = reserveBtn.innerHTML;
        reserveBtn.disabled = true;
        reserveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Preparing Checkout...`;

        try {
            // 1. Create order on server
            const response = await fetch("/listings/<%= listing._id %>/create-order", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({ checkIn, checkOut, guests }),
            });

            const data = await response.json();

            if (!data.success) {
                alert(data.message || "Failed to initialize payment.");
                reserveBtn.disabled = false;
                reserveBtn.innerHTML = originalText;
                return;
            }

            // 2. Configure Razorpay Checkout modal
            const options = {
                key: data.keyId,
                amount: data.amount,
                currency: data.currency,
                name: "Rentrova",
                description: `Reservation for ${data.listingTitle}`,
                image: "https://cdn-icons-png.flaticon.com/512/854/854878.png",
                order_id: data.orderId,
                prefill: {
                    name: data.user.name,
                    email: data.user.email,
                },
                theme: {
                    color: "#FF385C",
                },
                handler: async function (paymentResponse) {
                    reserveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Verifying Payment...`;
                    
                    // 3. Verify Payment on server
                    const verifyRes = await fetch("/listings/<%= listing._id %>/verify-payment", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            razorpay_order_id: paymentResponse.razorpay_order_id,
                            razorpay_payment_id: paymentResponse.razorpay_payment_id,
                            razorpay_signature: paymentResponse.razorpay_signature,
                            bookingId: data.bookingId,
                        }),
                    });

                    const verifyData = await verifyRes.json();
                    if (verifyData.success && verifyData.redirectUrl) {
                        window.location.href = verifyData.redirectUrl;
                    } else {
                        alert(verifyData.message || "Payment verification failed.");
                        reserveBtn.disabled = false;
                        reserveBtn.innerHTML = originalText;
                    }
                },
                modal: {
                    ondismiss: function () {
                        reserveBtn.disabled = false;
                        reserveBtn.innerHTML = originalText;
                    }
                }
            };

            const rzp = new Razorpay(options);
            rzp.on("payment.failed", function (failResponse) {
                alert(`Payment Failed: ${failResponse.error.description || 'Unknown error'}`);
                reserveBtn.disabled = false;
                reserveBtn.innerHTML = originalText;
            });
            rzp.open();

        } catch (err) {
            console.error(err);
            alert("An error occurred while connecting to payment gateway.");
            reserveBtn.disabled = false;
            reserveBtn.innerHTML = originalText;
        }
    }
</script>