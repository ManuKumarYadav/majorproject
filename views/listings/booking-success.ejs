<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center py-4">
    <div class="col-lg-8 col-md-10">
        
        <div class="luxury-form-card p-4 p-md-5 text-center">
            
            <!-- Success Animated Emblem -->
            <div class="brand-icon-wrapper mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.2rem; background: linear-gradient(135deg, #10B981, #059669); box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);">
                <i class="fa-solid fa-circle-check text-white"></i>
            </div>

            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold mb-2">
                <i class="fa-solid fa-shield-check me-1"></i> Payment Verified & Confirmed
            </span>

            <h2 class="fw-extrabold text-dark mt-2 mb-1">Pack your bags! You're all set.</h2>
            <p class="text-muted mb-4">Your reservation at <strong><%= booking.listing.title %></strong> is officially confirmed.</p>

            <!-- Booking Summary Card -->
            <div class="card border rounded-4 text-start p-3 p-md-4 mb-4 bg-light">
                <div class="row g-3 align-items-center mb-3 pb-3 border-bottom">
                    <div class="col-md-3">
                        <img 
                            src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80' %>" 
                            alt="<%= booking.listing.title %>"
                            class="rounded-3 w-100 object-fit-cover shadow-sm"
                            style="height: 90px;"
                        />
                    </div>
                    <div class="col-md-9">
                        <h5 class="fw-bold mb-1 text-dark"><%= booking.listing.title %></h5>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= booking.listing.location %>, <%= booking.listing.country %></p>
                    </div>
                </div>

                <!-- Reservation Metadata Grid -->
                <div class="row g-3 text-secondary small">
                    <div class="col-6 col-md-3">
                        <strong class="d-block text-dark mb-1">Check-in:</strong>
                        <span><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                    <div class="col-6 col-md-3">
                        <strong class="d-block text-dark mb-1">Checkout:</strong>
                        <span><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                    <div class="col-6 col-md-3">
                        <strong class="d-block text-dark mb-1">Guests & Nights:</strong>
                        <span><%= booking.guests %> Guest(s) • <%= booking.nights %> Night(s)</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <strong class="d-block text-dark mb-1">Total Paid:</strong>
                        <span class="fw-bold text-success fs-6">&#8377; <%= Number(booking.totalAmount).toLocaleString("en-IN") %></span>
                    </div>
                </div>

                <!-- Payment Details -->
                <div class="mt-3 pt-3 border-top d-flex justify-content-between flex-wrap gap-2 text-muted small">
                    <span><strong>Payment ID:</strong> <code><%= booking.razorpayPaymentId || 'N/A' %></code></span>
                    <span><strong>Order ID:</strong> <code><%= booking.razorpayOrderId %></code></span>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
                <a href="/listings/<%= booking.listing._id %>" class="btn btn-luxury-secondary">
                    <i class="fa-solid fa-eye me-1"></i> View Stay Details
                </a>
                <a href="/listings" class="btn btn-luxury-primary" style="width: auto; min-width: 180px;">
                    <i class="fa-solid fa-compass me-1"></i> Explore More Stays
                </a>
            </div>

        </div>

    </div>
</div>
