<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center py-4">
    <div class="col-lg-8 col-md-10">
        
        <div class="luxury-form-card">
            <div class="form-header-badge">
                <i class="fa-solid fa-pen-to-square"></i> Editor Mode
            </div>
            <h2 class="form-luxury-title">Edit Your Listing Details</h2>
            <p class="form-luxury-subtitle">Keep your property details, pricing, and visual presentation up to date.</p>

            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                
                <!-- Listing Title -->
                <div class="mb-4">
                    <label for="title" class="form-label-modern">
                        <i class="fa-solid fa-heading text-danger"></i> Listing Title
                    </label>
                    <input 
                        name="listing[title]" 
                        id="title"
                        value="<%= listing.title %>" 
                        type="text" 
                        class="form-control form-control-modern" 
                        required
                    />
                    <div class="invalid-feedback">Title is required.</div>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <label for="description" class="form-label-modern">
                        <i class="fa-solid fa-align-left text-danger"></i> Description
                    </label>
                    <textarea 
                        name="listing[description]" 
                        id="description"
                        rows="4" 
                        class="form-control form-control-modern" 
                        required
                    ><%= listing.description %></textarea>
                    <div class="invalid-feedback">Description is required.</div>
                </div>

                <!-- Existing & New Image Section -->
                <div class="mb-4">
                    <label class="form-label-modern mb-2">
                        <i class="fa-solid fa-image text-danger"></i> Current Property Image
                    </label>
                    <div class="p-2 border rounded-4 bg-light mb-3 d-inline-block">
                        <img 
                            src="<%= originalImageUrl %>" 
                            alt="Current Listing Image" 
                            class="rounded-3 shadow-sm" 
                            style="max-height: 180px; width: auto; object-fit: cover;"
                        />
                    </div>

                    <label class="form-label-modern">
                        <i class="fa-solid fa-cloud-arrow-up text-danger"></i> Replace with New Image (Optional)
                    </label>
                    <div class="upload-dropzone" onclick="document.getElementById('editImageFileInput').click()">
                        <i class="fa-solid fa-arrow-up-from-bracket upload-dropzone-icon"></i>
                        <h6 class="fw-bold mb-1">Click to select new replacement image</h6>
                        <p class="text-muted small mb-0">Leave empty to keep existing image</p>
                        <input 
                            id="editImageFileInput" 
                            name="listing[image]" 
                            type="file" 
                            class="d-none" 
                            accept="image/*" 
                            onchange="previewEditImage(event)"
                        />
                    </div>

                    <!-- New Image Preview Container -->
                    <div id="editImagePreviewWrapper" class="upload-preview-container">
                        <img id="editImagePreviewImg" class="upload-preview-img" src="" alt="New Image Preview">
                    </div>
                </div>

                <!-- Price and Country Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-5">
                        <label for="price" class="form-label-modern">
                            <i class="fa-solid fa-indian-rupee-sign text-danger"></i> Price per night (INR)
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 fw-bold">&#8377;</span>
                            <input 
                                name="listing[price]" 
                                id="price"
                                value="<%= listing.price %>" 
                                type="number" 
                                min="100"
                                class="form-control form-control-modern border-start-0" 
                                required
                            />
                        </div>
                        <div class="invalid-feedback">Please enter a valid price amount.</div>
                    </div>

                    <div class="col-md-7">
                        <label for="country" class="form-label-modern">
                            <i class="fa-solid fa-globe text-danger"></i> Country
                        </label>
                        <input 
                            name="listing[country]" 
                            id="country"
                            value="<%= listing.country %>" 
                            type="text" 
                            class="form-control form-control-modern" 
                            required
                        />
                        <div class="invalid-feedback">Country name is required.</div>
                    </div>
                </div>

                <!-- Location -->
                <div class="mb-4">
                    <label for="location" class="form-label-modern">
                        <i class="fa-solid fa-location-dot text-danger"></i> Location / City
                    </label>
                    <input 
                        name="listing[location]" 
                        id="location"
                        value="<%= listing.location %>" 
                        type="text" 
                        class="form-control form-control-modern" 
                        required
                    />
                    <div class="invalid-feedback">Location is required.</div>
                </div>

                <!-- Submit and Cancel Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top">
                    <a href="/listings/<%= listing._id %>" class="btn btn-luxury-secondary">Discard Changes</a>
                    <button type="submit" class="btn btn-luxury-primary" style="width: auto; min-width: 180px;">
                        <i class="fa-solid fa-check me-1"></i> Save Changes
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>

<script>
    function previewEditImage(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const wrapper = document.getElementById("editImagePreviewWrapper");
                const img = document.getElementById("editImagePreviewImg");
                img.src = e.target.result;
                wrapper.style.display = "block";
            }
            reader.readAsDataURL(file);
        }
    }
</script>