<% layout("/layouts/boilerplate") %>

<style>
  .legal-hero {
    background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
    padding: 5rem 0 4rem;
    color: #fff;
    text-align: center;
  }
  .legal-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .legal-hero p { opacity: 0.8; font-size: 1.05rem; }
  .legal-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
  }
  .legal-toc {
    background: var(--slate-50, #F8FAFC);
    border: 1px solid var(--slate-200, #E2E8F0);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    margin-bottom: 3rem;
  }
  [data-theme="dark"] .legal-toc { background: #141C2C; border-color: #1E293B; }
  .legal-toc h2 { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; }
  .legal-toc ol { margin: 0; padding-left: 1.2rem; }
  .legal-toc ol li { margin-bottom: 0.35rem; }
  .legal-toc ol li a { color: #FF385C; text-decoration: none; font-size: 0.93rem; font-weight: 500; }
  .legal-toc ol li a:hover { text-decoration: underline; }

  .legal-section { margin-bottom: 3rem; scroll-margin-top: 100px; }
  .legal-section h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--slate-900);
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid #1E293B;
    display: inline-block;
  }
  [data-theme="dark"] .legal-section h2 { color: #F1F5F9; border-bottom-color: #334155; }
  .legal-section h3 { font-size: 1.05rem; font-weight: 700; color: var(--slate-800); margin: 1.2rem 0 0.5rem; }
  [data-theme="dark"] .legal-section h3 { color: #CBD5E1; }
  .legal-section p, .legal-section li { font-size: 0.97rem; line-height: 1.8; color: var(--slate-600); }
  [data-theme="dark"] .legal-section p,
  [data-theme="dark"] .legal-section li { color: #94A3B8; }
  .legal-section ul { padding-left: 1.4rem; }
  .legal-section ul li { margin-bottom: 0.4rem; }

  .legal-highlight-box {
    background: rgba(30, 41, 59, 0.06);
    border-left: 4px solid #1E293B;
    border-radius: 0 12px 12px 0;
    padding: 1rem 1.4rem;
    margin: 1.2rem 0;
    font-size: 0.95rem;
    color: var(--slate-700);
  }
  [data-theme="dark"] .legal-highlight-box { background: rgba(255,255,255,0.04); border-left-color: #475569; color: #CBD5E1; }

  .terms-clause {
    background: var(--slate-50, #F8FAFC);
    border: 1px solid var(--slate-200, #E2E8F0);
    border-radius: 12px;
    padding: 1.2rem 1.5rem;
    margin-bottom: 1rem;
  }
  [data-theme="dark"] .terms-clause { background: #1A2332; border-color: #1E293B; }
  .terms-clause strong { display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--slate-800); }
  [data-theme="dark"] .terms-clause strong { color: #E2E8F0; }
  .terms-clause p { margin: 0; font-size: 0.92rem; color: var(--slate-600); }
  [data-theme="dark"] .terms-clause p { color: #94A3B8; }

  .legal-contact-card {
    background: linear-gradient(135deg, rgba(30,41,59,0.06), rgba(30,41,59,0.02));
    border: 1px solid rgba(30,41,59,0.2);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    margin-top: 2.5rem;
  }
  [data-theme="dark"] .legal-contact-card { background: rgba(255,255,255,0.03); border-color: #1E293B; }
  .legal-contact-card h3 { font-weight: 700; color: var(--slate-900); margin-bottom: 0.5rem; }
  [data-theme="dark"] .legal-contact-card h3 { color: #F1F5F9; }
  .legal-contact-card p { color: var(--slate-600); font-size: 0.95rem; }
  [data-theme="dark"] .legal-contact-card p { color: #94A3B8; }
  .legal-contact-card a { color: #FF385C; font-weight: 600; text-decoration: none; }

  .legal-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: rgba(255,255,255,0.15); color: #fff;
    border-radius: 999px; padding: 0.3rem 0.9rem;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; margin-bottom: 1rem;
  }

  .penalty-table { width: 100%; border-collapse: collapse; margin-top: 1rem; border-radius: 10px; overflow: hidden; }
  .penalty-table th { background: #1E293B; color: #fff; font-size: 0.85rem; padding: 0.7rem 1rem; text-align: left; }
  .penalty-table td { font-size: 0.88rem; padding: 0.65rem 1rem; border-bottom: 1px solid var(--slate-200); color: var(--slate-700); }
  [data-theme="dark"] .penalty-table td { border-bottom-color: #1E293B; color: #CBD5E1; }
  .penalty-table tr:last-child td { border-bottom: none; }
  .penalty-table tr:nth-child(even) td { background: var(--slate-50); }
  [data-theme="dark"] .penalty-table tr:nth-child(even) td { background: #141C2C; }
</style>

