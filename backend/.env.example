# Render Backend Environment Variables

NODE_ENV=production
PORT=8080

# Frontend URL (Deployed Vercel App URL without trailing slash)
FRONTEND_URL=https://stayaira.vercel.app

# MongoDB Atlas Connection String
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/MAJORPROJECT?retryWrites=true&w=majority

# Session Secret Key
SECRET=stayaira_super_secret_session_key

# Cloudinary Credentials (For Listing Image Uploads)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# Razorpay API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://stayaira-backend.onrender.com/auth/google/callback

# Nodemailer / Gmail SMTP for Password Resets
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Firebase Web App Config
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
